{
  "name": "quan-ly-cau-lac-bo-va-lich-tap-bong-da",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:backend": "npm run start:dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"magenta,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "seed": "npm run seed --prefix backend",
    "install:all": "npm install --prefix backend && npm install --prefix frontend && npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0"
  }
}
